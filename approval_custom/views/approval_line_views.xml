<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Line (Audit Trail) tree view -->
    <record id="approval_line_view_tree" model="ir.ui.view">
        <field name="name">approval.line.view.tree</field>
        <field name="model">approval.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-success="action == 'approved'" decoration-danger="action == 'refused'" decoration-warning="action == 'escalated'" decoration-info="action == 'submitted'">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="action" widget="badge"/>
                <field name="note"/>
                <field name="level_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Standalone action for all approval lines (for managers) -->
    <record id="approval_line_action" model="ir.actions.act_window">
        <field name="name">Approval Audit Trail</field>
        <field name="res_model">approval.line</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval actions recorded yet
            </p>
        </field>
    </record>
</odoo>
