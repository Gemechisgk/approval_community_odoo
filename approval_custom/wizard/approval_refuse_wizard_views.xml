<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_refuse_wizard_view_form" model="ir.ui.view">
        <field name="name">approval.refuse.wizard.form</field>
        <field name="model">approval.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Request">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="approver_id" invisible="1"/>
                    <field name="reason" placeholder="Please provide a reason for refusing this request..."/>
                </group>
                <footer>
                    <button name="action_refuse" string="Refuse" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
