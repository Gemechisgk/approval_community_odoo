<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- General Approval -->
        <record id="approval_category_data_general" model="approval.category">
            <field name="name">General Approval</field>
            <field name="sequence">1</field>
            <field name="description">General purpose approval requests</field>
            <field name="has_date">optional</field>
            <field name="has_amount">optional</field>
            <field name="has_reference">optional</field>
            <field name="has_partner">optional</field>
            <field name="approval_minimum">1</field>
        </record>

        <!-- Purchase Request -->
        <record id="approval_category_data_purchase" model="approval.category">
            <field name="name">Purchase Request</field>
            <field name="sequence">2</field>
            <field name="description">Request approval for purchases</field>
            <field name="has_amount">required</field>
            <field name="has_product">required</field>
            <field name="has_quantity">required</field>
            <field name="has_partner">required</field>
            <field name="has_date">optional</field>
            <field name="has_reference">optional</field>
            <field name="approval_minimum">1</field>
        </record>

        <!-- Expense Report -->
        <record id="approval_category_data_expense" model="approval.category">
            <field name="name">Expense Report</field>
            <field name="sequence">3</field>
            <field name="description">Submit expenses for approval</field>
            <field name="has_amount">required</field>
            <field name="has_date">required</field>
            <field name="has_partner">optional</field>
            <field name="has_payment_method">required</field>
            <field name="has_reference">optional</field>
            <field name="requirer_document">required</field>
            <field name="approval_minimum">1</field>
        </record>

        <!-- Business Trip -->
        <record id="approval_category_data_trip" model="approval.category">
            <field name="name">Business Trip</field>
            <field name="sequence">4</field>
            <field name="description">Request approval for business travel</field>
            <field name="has_date">required</field>
            <field name="has_period">required</field>
            <field name="has_location">required</field>
            <field name="has_amount">optional</field>
            <field name="has_partner">optional</field>
            <field name="approval_minimum">1</field>
        </record>

        <!-- Equipment Request -->
        <record id="approval_category_data_equipment" model="approval.category">
            <field name="name">Equipment Request</field>
            <field name="sequence">5</field>
            <field name="description">Request equipment or supplies</field>
            <field name="has_product">required</field>
            <field name="has_quantity">required</field>
            <field name="has_date">optional</field>
            <field name="has_location">optional</field>
            <field name="approval_minimum">1</field>
        </record>
    </data>
</odoo>
