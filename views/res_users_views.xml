<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend user form to show delegation info -->
    <record id="res_users_view_form_inherit_approval" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.approval</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Approval Delegation" name="approval_delegation" groups="approval_custom.group_approval_user">
                    <group string="Active Delegations">
                        <p class="text-muted" colspan="2">
                            Delegations allow you to temporarily transfer your approval authority to another user.
                            Use the Configuration menu to manage delegations.
                        </p>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
